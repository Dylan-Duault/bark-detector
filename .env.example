# Copy to .env and choose your own four-digit code.
DASHBOARD_PIN=

# Play the next MP3 in data/music after this many detections in the window.
BARK_MUSIC_ENABLED=false
BARK_MUSIC_BARK_COUNT=20
BARK_MUSIC_WINDOW_SECONDS=300
BARK_MUSIC_VOLUME_PERCENT=35

# Central configuration (defaults shown). Paths may be absolute.
# DATA_DIR=/home/pi/bark-detector/data
HOST=0.0.0.0
PORT=8080
COOKIE_SECURE=false
BARK_SPEAKER_ADDRESS=74:68:59:AA:5E:05

# Detection / recording / statistical series
MIN_BARK_VOLUME=0.012
TOP_N_CLASSES=5
BARK_CLASS_NAME=Dog
CONSECUTIVE_BARKS=2
RECORD_DURATION=60
RECORD_QUIET_SECONDS=10
SESSION_GAP_SECONDS=90
MIN_BARKS_PER_SESSION=2
MIN_SESSION_DURATION=0

# Optional two-way live audio. Install the live extra, then enable on both services.
LIVE_AUDIO_ENABLED=false
LIVE_VOICE_VOLUME_PERCENT=30
# Cloudflare Realtime TURN, for networks that cannot connect directly.
# LIVE_TURN_KEY_ID=
# LIVE_TURN_KEY=
