[Unit]
Description=Dog bark mobile dashboard
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
WorkingDirectory=@PROJECT@
ExecStart=@PYTHON@ -u @PROJECT_ARG@/web_server.py --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
